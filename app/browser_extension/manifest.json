{
  "manifest_version": 3,
  "name": "CS2Toolkit 网页连接",
  "version": "0.1.0",
  "description": "配合 CS2 工具箱，稳定绑定目标网页，在死亡切屏和返回游戏时控制视频播放与暂停。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "*://*.bilibili.com/*", "*://*.douyin.com/*", "*://*.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_start"},
    {"matches": ["*://*.bilibili.com/*", "*://*.douyin.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}
  ]
}
