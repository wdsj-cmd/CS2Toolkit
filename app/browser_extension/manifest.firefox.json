{
  "manifest_version": 3,
  "name": "CS2Toolkit 网页连接",
  "version": "0.1.0",
  "description": "配合 CS2 工具箱稳定绑定网页并控制视频播放与暂停。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "*://*.bilibili.com/*", "*://*.douyin.com/*", "*://*.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["protocol.js", "background.js"]},
  "action": {"default_popup": "popup.html"},
  "browser_specific_settings": {"gecko": {"id": "cs2toolkit-media@wdsj-cmd", "strict_min_version": "109.0"}},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_start"},
    {"matches": ["*://*.bilibili.com/*", "*://*.douyin.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}
  ]
}
